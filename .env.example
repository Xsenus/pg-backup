
# Где хранить бэкапы (на VPS)
BACKUP_ROOT=/opt/pg-backups

# Сколько полных копий хранить на БД (FIFO-ротация)
RETENTION=10

# Дополнительные опции для pg_dump (пример)
PG_DUMP_OPTS="--no-owner --no-privileges -Z9"

# Куда писать развернутые логи
LOG_DIR=/var/log/pg-multi-backup

# Список URL. Скрипт сам заменит 'postgresql+asyncpg://' -> 'postgresql://'
MAIN_DATABASE_URL=postgresql+asyncpg://admin:***@79.174.94.14:5464/postgres
BITRIX_DATABASE_URL=postgresql+asyncpg://admin:***@79.174.94.14:5464/bitrix_data
PARSING_DATABASE_URL=postgresql+asyncpg://admin:***@79.174.94.14:5464/postgres
PP719_DATABASE_URL=postgresql+asyncpg://admin:***@79.174.94.14:5464/pp719
