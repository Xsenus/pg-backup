[Unit]
Description=PostgreSQL multi-database backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/pg-multi-backup.env
ExecStart=/usr/bin/env bash /opt/pg-backup/scripts/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=journal
StandardError=journal
